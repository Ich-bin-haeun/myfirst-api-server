pipeline {
  agent any

  environment {
    // === 사용자 수정 영역 ===
    GIT_URL                = 'https://github.com/Ich-bin-haeun/myfirst-api-server.git'
    GIT_BRANCH             = 'main'            // 또는 main
    GIT_ID                 = 'sk122-github-id'   // GitHub PAT credential ID
    IMAGE_NAME             = 'sk122-webserver'
    // =======================
    IMAGE_TAG              = '1.0'
    IMAGE_REGISTRY_URL     = 'skala-registry.skala-ai.com'
    IMAGE_REGISTRY_PROJECT = 'class-4'

    DOCKER_CREDENTIAL_ID   = 'skala-image-registry-id'  // Harbor 인증 정보 ID
    K8S_NAMESPACE          = 'class-4'
    GITOPS_BRANCH          = 'gitops'
    GITOPS_MANIFEST_DIR    = 'kustomize/overlays/dev'
  }

  options {
    disableConcurrentBuilds()
    timestamps()
  }

  stages {
    stage('Clone Repository') {
      steps {
        echo 'Clone Repository'
        git branch: "${GIT_BRANCH}", url: "${GIT_URL}", credentialsId: "${GIT_ID}"
        sh 'ls -al'
      }
    }

    stage('Build with Maven') {
      steps {
        echo 'Build with Maven'
        sh 'mvn -s settings.xml clean package -DskipTests'
        // sh 'mvn clean package -DskipTests'
        sh 'ls -al'
      }
    }

    // 로그인/빌드/푸시/정리
    stage('Image Build & Push (Buildah)') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: "${DOCKER_CREDENTIAL_ID}",
          usernameVariable: 'REG_USER',
          passwordVariable: 'REG_PASS'
        )]) {
        script {
          // 이미지 태그 = IMAGE_TAG-빌드번호-커밋해시(7자리), GitOps 스테이지에서도 동일 값 사용
          def shortCommit = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
          env.FINAL_IMAGE_TAG = "${env.IMAGE_TAG}-bd${env.BUILD_NUMBER}-${env.JOB_BASE_NAME}-${shortCommit}"
        }
        sh '''
            set +x
            set -eu
            REG_HOST="${IMAGE_REGISTRY_URL}"
            IMAGE_REF="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}:${FINAL_IMAGE_TAG}"

            # 1. 로그인
            echo "Login to $REG_HOST as $REG_USER"
            printf '%s' "$REG_PASS" | sudo buildah login -u "$REG_USER" --password-stdin "$REG_HOST"

            # 2. 빌드
            sudo buildah bud --storage-driver vfs --platform "linux/amd64" -t "${IMAGE_REF}" .
            # 3. 푸시
            sudo buildah push --storage-driver vfs "${IMAGE_REF}"
            # 4. 정리
            sudo buildah rmi --storage-driver=vfs "${IMAGE_REF}" || true
        '''
        }
      }
    }

    // GitOps 업데이트 (ArgoCD CD 트리거) ────────────────
    // kustomize/overlays/dev 이미지 태그 수정 후 gitops 브랜치에 push
    stage('GitOps Update') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: "${GIT_ID}",
          usernameVariable: 'GIT_USER',
          passwordVariable: 'GIT_PASS'
        )]) {
          sh '''
            set +x
            set -eu
            git config user.name "sk122-gitops"
            git config user.email "jenkins@localhost"
            git remote set-url origin "${GIT_URL}"

            ASKPASS_FILE=$(mktemp)
            trap 'rm -f "$ASKPASS_FILE"' EXIT
            cat > "$ASKPASS_FILE" <<'ASKPASS'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\n' "$GIT_USER" ;;
  *Password*) printf '%s\n' "$GIT_PASS" ;;
esac
ASKPASS
            chmod 700 "$ASKPASS_FILE"
            export GIT_ASKPASS="$ASKPASS_FILE" GIT_TERMINAL_PROMPT=0

            # Preserve existing GitOps commits and use a normal fast-forward push.
            if git ls-remote --exit-code --heads origin "refs/heads/${GITOPS_BRANCH}" > /dev/null; then
              git fetch origin "${GITOPS_BRANCH}"
              git checkout -B "${GITOPS_BRANCH}" FETCH_HEAD
            else
              git checkout -b "${GITOPS_BRANCH}"
            fi

            IMAGE_BASE="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}"
            (cd "${GITOPS_MANIFEST_DIR}" && kustomize edit set image "${IMAGE_BASE}=${IMAGE_BASE}:${FINAL_IMAGE_TAG}")
            git add "${GITOPS_MANIFEST_DIR}/kustomization.yaml"
            if ! git diff --cached --quiet; then
              git commit -m "[AUTO] image: ${IMAGE_NAME}:${FINAL_IMAGE_TAG}"
            fi
            git push origin "HEAD:refs/heads/${GITOPS_BRANCH}"
            echo "[DONE] GitOps update: ${IMAGE_BASE}:${FINAL_IMAGE_TAG}"
          '''
        }
      }
    }

  }

  post {
    always {
      deleteDir()  // 워크스페이스 정리 (git clone, target/, 빌드 아티팩트)
    }
  }
}
